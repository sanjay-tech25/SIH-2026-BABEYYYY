# Application Settings
PROJECT_NAME="SIH Adaptive Learning & Quantum Platform"
API_V1_STR="/api/v1"
DEBUG=true
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="supersecretdevelopmentkeypleasereplaceinproduction"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./sih_adaptive.db"
# PostgreSQL Example: DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sih_db"

# CORS Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Quantum Simulation
QUANTUM_MAX_QUBITS=10
QUANTUM_MAX_DEPTH=100
QUANTUM_DEFAULT_SHOTS=1024

# AI Tutor Configuration
AI_PROVIDER="mock"  # Options: "mock", "gemini", "openai"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
